# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your Vercel project for production.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: your real domain (link previews, sitemap) and the gym's name
# (landing page). Leave out until you have them.
# NEXT_PUBLIC_SITE_URL=https://racked.run
# NEXT_PUBLIC_GYM_NAME=Your Gym, Baner

# Only needed for scripts/seed.ts (never exposed to the browser — do NOT
# prefix this with NEXT_PUBLIC_). Supabase project settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
